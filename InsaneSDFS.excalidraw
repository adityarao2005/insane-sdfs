    {
      "id": "7Hl1V99WisC9--jxQxV4q",
      "type": "text",
      "x": 6317.883113422122,
      "y": 1844.197246569654,
      "width": 1601.603515625,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1C",
      "roundness": null,
      "seed": 2103273542,
      "version": 599,
      "versionNonce": 1558683846,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1761537932531,
      "link": null,
      "locked": false,
      "text": "File Server will be on private mode runnning on machine and will \"register\" itself to the\ngateway. This means gateway forwards all commands sent by file clients to specified file\nserver. Communication between file client and file server via gateway will eihter be via gRPC\nor a specific HTTP/3 implementation\n\nFile sending outputs will be chunked\nService discovery via global networks will also be available\n\nFile server actions will mostly be one register service with it streaming messages\n\nFile client actions will  be plentiful and have JWT tokens passed as well",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "v7OwXEFMLHHr10u3myLdX",
      "originalText": "File Server will be on private mode runnning on machine and will \"register\" itself to the gateway. This means gateway forwards all commands sent by file clients to specified file server. Communication between file client and file server via gateway will eihter be via gRPC or a specific HTTP/3 implementation\n\nFile sending outputs will be chunked\nService discovery via global networks will also be available\n\nFile server actions will mostly be one register service with it streaming messages\n\nFile client actions will  be plentiful and have JWT tokens passed as well",
      "autoResize": true,
      "lineHeight": 1.25
    },
