{
  "name": "insane-sdfs-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "proto:create": "rm -rf ./src/proto && mkdir ./src/proto && grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./src/proto --ts_out=grpc_js:./src/proto --grpc_out=grpc_js:./src/proto --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` -I ../proto ../proto/*.proto",
    "start": "bun run src/index.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "grpc-tools": "^1.13.0",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "typescript": "^5.9.3",
    "@types/bun": "latest"
  },
  "module": "src/index.ts",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "path": "^0.12.7"
  }
}