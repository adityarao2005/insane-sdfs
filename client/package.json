{
    "name": "insane-sdfs-client",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "proto:create": "rm -rf ./src/proto && mkdir ./src/proto && grpc_tools_node_protoc --ts_out=grpc_js:./src/proto --grpc_out=./src/proto --plugin=protoc-gen-grpc=`which grpc_tools_node_protoc_plugin` -I ../proto ../proto/*.proto",
        "start": "bun run src/index.ts"
    },
    "devDependencies": {
        "grpc_tools_node_protoc_ts": "^5.3.3",
        "typescript": "^5.9.3"
    }
}